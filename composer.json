{
    "name": "company/audit-client",
    "description": "Thin Laravel SDK for the Audit Log Hub REST API: queued, batched, signed and masked audit logs.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "audit", "audit-log", "sdk"],
    "authors": [
        {
            "name": "Sadeen Al-Harbi",
            "email": "sadeenalharbi.22@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Company\\AuditClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Company\\AuditClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Company\\AuditClient\\AuditClientServiceProvider"
            ],
            "aliases": {
                "Audit": "Company\\AuditClient\\Facades\\Audit"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
